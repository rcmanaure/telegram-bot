# ─── API Keys ───────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...        # https://openrouter.ai (used for LLM + embeddings)
LLM_API_KEY=                        # Takes precedence over OPENROUTER_API_KEY if both set
EMBEDDING_API_KEY=                  # Must be set explicitly for embedding provider
TELEGRAM_BOT_TOKEN=...              # From @BotFather
GROQ_API_KEY=                       # STT for voice notes — get from console.groq.com

# ─── Encryption ─────────────────────────────────────────────
# Required for encrypting secrets stored in DB (WA credentials, config overlay).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── Database ───────────────────────────────────────────────
# Docker: use @postgres; local dev without Docker: @localhost
DATABASE_URL=postgresql+asyncpg://ragbot:ragbot@postgres:5432/ragbot
DATABASE_URL_SYNC=postgresql://ragbot:ragbot@postgres:5432/ragbot

# ─── Models (OpenRouter default) ────────────────────────────
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/free                      # primary model (free tier)
LLM_FALLBACK_MODEL=openrouter/free,xiaomi/mimo-v2.5  # comma-separated chain; empty = disabled
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-small   # via OpenRouter
EMBEDDING_DIM=1536

# ─── Ollama Cloud (alternative to OpenRouter) ───────────────
# Ollama cloud has NO embeddings endpoint — keep EMBEDDING_* pointing at OpenRouter.
# Validate web search endpoint before enabling: curl -H "Authorization: Bearer $LLM_API_KEY" https://ollama.com/api/web_search -d '{"query":"test"}'
#
# LLM_API_KEY=ollama-...
# LLM_MODEL=llama3.2
# LLM_FALLBACK_MODEL=
# LLM_VISION_MODEL=gemma4:31b    # vision-capable model for image queries; empty = no vision
# WEB_SEARCH_URL=                 # set to https://ollama.com/api/web_search once validated

# ─── RAG Settings ───────────────────────────────────────────
CHUNK_SIZE=500          # characters per chunk
CHUNK_OVERLAP=50        # overlap between chunks
TOP_K_RESULTS=4         # how many chunks to retrieve

# ─── App ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# LOCAL DEV: leave as localhost:8000 (ngrok overrides at runtime)
# PROD (VPS): set to your domain, e.g. srv1546906.hstgr.cloud
APP_DOMAIN=localhost:8000

# LOCAL DEV: leave empty (ngrok handles webhook URL)
# PROD (VPS): must match APP_DOMAIN — used by Traefik routing labels
TRAEFIK_HOST=

DEFAULT_NAMESPACE=demo

# ─── Admin ──────────────────────────────────────────────────
ADMIN_PASSWORD=changeme             # CHANGE THIS IN PRODUCTION

# ─── Observability ──────────────────────────────────────────
SENTRY_DSN=                         # Optional — leave empty to disable
ENVIRONMENT=dev                     # dev | staging | production